# Copiá este archivo como .env y completá lo que necesites. Todo es opcional.
# .env no se sube al repo; acá van también las API keys que se sumen más adelante.

# Puerto local de la interfaz
# JARVIS_PORT=7777

# Modelo de Claude (vacío = el de tu cuenta). Ej.: sonnet, haiku
# JARVIS_MODEL=

# Cuenta de Google con la que abrir Calendar, Gmail o Drive si tenés varias en el navegador
# JARVIS_GOOGLE_ACCOUNT=tu-mail@ejemplo.com

# Ruta al ejecutable de Claude Code (se autodetecta)
# CLAUDE_BIN=

# Tu nombre, para que JARVIS te salude y te llame así (opcional)
# JARVIS_USER_NAME=

# Zona horaria para la fecha que ve JARVIS. Ej.: America/Argentina/Buenos_Aires (por defecto, la del sistema)
# JARVIS_TIMEZONE=

# Modelo de cada subagente (por defecto: agenda haiku, correo y investigador sonnet)
# JARVIS_AGENT_AGENDA_MODEL=
# JARVIS_AGENT_CORREO_MODEL=
# JARVIS_AGENT_INVESTIGADOR_MODEL=
